App(
    appid="guesser",
    name="Guesser",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="guesser_app",
    # Explicit: the default glob would also sweep up tests/ (desktop-only, built
    # by tests/Makefile) and anything under venv/.
    sources=[
        "guesser_app.c",
        "scenes/*.c",
        "views/*.c",
        "helpers/*.c",
    ],
    stack_size=2 * 1024,
    fap_category="Games",
    fap_icon="guesser.png",
    fap_icon_assets="images",
    fap_file_assets="files",
    fap_description="Think of anything - the Flipper guesses it. 5000+ things, fully offline.",
    fap_author="King-Kong-341",
    fap_weburl="https://github.com/King-Kong-341/Flipper-Zero-Games_Guesser",
    fap_version=(1, 0),
)
